# ==============================================================================
# LO SDROGO GOLFOMETRO — SUPABASE CONFIGURATION (.env)
# ==============================================================================
# Copia questo file in '.env' e inserisci le tue credenziali Supabase.
#
# NOTA DI SICUREZZA:
# 1. Utilizza ESCLUSIVAMENTE la Public Anon Key ('anon' key) nel frontend.
# 2. NON inserire e NON richiedere MAI la 'service_role' key in questo file.
# 3. Le operazioni sensibili (deduzione crediti, scommesse, donazioni) sono
#    protette a livello di database tramite RLS e funzioni SECURITY DEFINER.
# ==============================================================================

# URL del tuo progetto Supabase (es. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon Public Key (es. eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
